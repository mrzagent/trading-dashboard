// â”€â”€ Timing helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Schedule (10-min window):
//   :00 â†’ Data fetch fires (second 0)
//   :01 â†’ Analysts fire   (second 60)
//   :04 â†’ Orchestrator fires (second 240)
function getSecsUntilFire(fireSecInWindow) {
  const now = new Date();
  const totalSec = now.getMinutes() * 60 + now.getSeconds();
  const windowSec = 600; // 10 min
  const posInWindow = totalSec % windowSec;

  let secsUntil;
  if (posInWindow < fireSecInWindow) {
    secsUntil = fireSecInWindow - posInWindow;
  } else if (posInWindow === fireSecInWindow) {
    secsUntil = windowSec; // just fired, next window
  } else {
    secsUntil = windowSec - posInWindow + fireSecInWindow;
  }
  return secsUntil;
}

function formatSecsCountdown(secs) {
  const s = Math.max(0, Math.floor(secs));
  const m = Math.floor(s / 60)
    .toString()
    .padStart(2, "0");
  const ss = (s % 60).toString().padStart(2, "0");
  return `${m}:${ss}`;
}

// â”€â”€ Formatters â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function formatPrice(price) {
  if (price == null) return "--";
  return (
    "$" +
    Number(price).toLocaleString("en-US", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })
  );
}

function formatPct(val) {
  if (val == null) return "--";
  const n = Number(val);
  return (n >= 0 ? "+" : "") + n.toFixed(2) + "%";
}

function formatVolume(v) {
  if (v === null || v === undefined) return "â€”";
  const n = parseFloat(v);
  if (n >= 1e9) return "$" + (n / 1e9).toFixed(2) + "B";
  if (n >= 1e6) return "$" + (n / 1e6).toFixed(2) + "M";
  return "$" + n.toLocaleString();
}

function formatRSI(val) {
  if (val == null) return "--";
  return Number(val).toFixed(1);
}

function formatTime(ts) {
  if (!ts) return "--";
  const d = new Date(ts);
  return d.toLocaleTimeString("en-US", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });
}

// â”€â”€ Countdown (receives remainingMs from page level â€” no internal timer) â”€â”€â”€â”€â”€â”€â”€
function Countdown({ remainingMs }) {
  if (remainingMs == null) return null;

  const totalSec = Math.max(0, Math.floor(remainingMs / 1000));
  const m = Math.floor(totalSec / 60)
    .toString()
    .padStart(2, "0");
  const s = (totalSec % 60).toString().padStart(2, "0");

  return (
    <span className="trading-countdown">
      Next update in{" "}
      <span className="countdown-value">
        {m}:{s}
      </span>
      <span className="countdown-source"> Â· via CoinGecko</span>
    </span>
  );
}

// â”€â”€ Change / badge components â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function ChangeBadge({ label, value }) {
  if (value === null || value === undefined)
    return (
      <span className="change-badge neutral">
        <span className="badge-label">{label}</span> â€”
      </span>
    );
  const pos = parseFloat(value) >= 0;
  return (
    <span className={`change-badge ${pos ? "positive" : "negative"}`}>
      <span className="badge-label">{label}</span>
      {pos ? "+" : ""}
      {parseFloat(value).toFixed(2)}%
    </span>
  );
}

// â”€â”€ CoinCard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function CoinCard({ row }) {
  const coin = row.coin;

  return (
    <div
      className={`coin-card${row.alert_triggered ? " coin-card--alert" : ""}`}
    >
      {row.alert_triggered && <div className="alert-badge">Alert</div>}
      <div className="coin-header">
        <span
          className="coin-symbol"
          style={{ color: COIN_COLOR[coin] || "#e8ecf4" }}
        >
          {COIN_ICON[coin] ? (
            <img src={COIN_ICON[coin]} alt={coin} className="coin-icon" />
          ) : (
            coin
          )}
        </span>
        <span className="coin-name">{coin}</span>
      </div>
      <div className="coin-price">{formatPrice(row.price)}</div>
      <div className="change-summary">
        <div className="change-badges">
          <ChangeBadge label="10m" value={row.change_10min} />
          <ChangeBadge label="1h" value={row.change_1h} />
          <ChangeBadge label="4h" value={row.change_4h} />
          <ChangeBadge label="24h" value={row.change_24h} />
        </div>
        <div className="coin-meta">
          <div className="coin-meta-item">
            <span className="meta-label">RSI</span>
            <span className="meta-value">{formatRSI(row.rsi)}</span>
          </div>
          <div className="coin-meta-item">
            <span className="meta-label">Momentum</span>
            <span className="meta-value">{row.momentum ?? "--"}</span>
          </div>
          <div className="coin-meta-item">
            <span className="meta-label"> Vol 24h:</span>
            <span className="meta-value"> {formatVolume(row.volume_24h)}</span>
          </div>
        </div>
