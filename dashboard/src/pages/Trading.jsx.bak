// Avatar: photo if available, else CSS initials circle
function AgentAvatar({ img, initials, color, name, size = 48 }) {
  const [err, setErr] = useState(false);

  if (img && !err) {
    return (
      <img
        src={img}
        alt={name}
        className="agent-avatar-img"
        style={{ width: size, height: size }}
        onError={() => setErr(true)}
      />
    );
  }

  return (
    <div
      className="agent-avatar-initials"
      style={{
        width: size,
        height: size,
        background: color,
        fontSize: size * 0.35,
      }}
      title={name}
    >
      {initials}
    </div>
  );
}

const COINS_ORDER = ["BTC", "ETH", "SOL"];

function actionTag(signalType) {
  if (!signalType) return "HOLD";
  const upper = signalType.toUpperCase();
  if (upper.includes("BUY")) return "BUY";
  if (upper.includes("SELL")) return "SELL";
  // NEUTRAL, HOLD, or anything else = HOLD
  return "HOLD";
}

function actionClass(signalType) {
  const tag = actionTag(signalType);
  if (tag === "BUY") return "buy";
  if (tag === "SELL") return "sell";
  return "hold";
}

function CoinSignals({ signals }) {
  if (!signals)
    return <div className="coin-signals coin-signals--empty">No data yet</div>;
  return (
    <div className="coin-signals">
      <div className="coin-signals-header">
        <span className="coin-signals-col-asset">Asset</span>
        <span className="coin-signals-col-result">Result</span>
        <span className="coin-signals-col-conf">Confidence</span>
      </div>
      {COINS_ORDER.map((coin) => {
        const s = signals[coin];
        const tag = s ? actionTag(s.signal_type) : "HOLD";
        const cls = s ? actionClass(s.signal_type) : "hold";
        const conf = s != null ? `${Math.round(parseFloat(s.confidence) * 100)}%` : "â€”";
        return (
          <div key={coin} className={`coin-signal-row coin-signal--${cls}`}>
            <span className="coin-signal-name">
              <img src={COIN_ICON[coin]} alt={coin} className="coin-icon" />{" "}
              {coin}
            </span>
            <span className={`coin-signal-action coin-signal-action--${cls}`}>{tag}</span>
            <span className="coin-signal-conf">{conf}</span>
          </div>
        );
      })}
    </div>
  );
}

