// â”€â”€ Main Page â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// ===== LastOutput component (Livingston) =====
function LastOutput({ signal }) {
  if (!signal) {
    return (
      <div style={{ fontSize: "0.7rem", color: "#6b7280", marginTop: "6px" }}>
        No data yet
      </div>
    );
  }
  const fmt = (dt) => {
    if (!dt) return "";
    const d = new Date(dt);
    const mo = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    const h = String(d.getHours()).padStart(2, "0");
    const min = String(d.getMinutes()).padStart(2, "0");
    return `${mo}/${day} ${h}:${min}`;
  };
  const pct =
    signal.confidence != null
      ? Math.round(parseFloat(signal.confidence) * 100)
      : "?";
  const notes = signal.notes
    ? signal.notes.length > 60
      ? signal.notes.slice(0, 60) + "â€¦"
      : signal.notes
    : "";
  return (
    <div
      style={{
        fontSize: "0.7rem",
        color: "#9ca3af",
        marginTop: "6px",
        lineHeight: 1.4,
      }}
    >
      <div style={{ color: "#d1d5db", fontWeight: 500 }}>Last output:</div>
      <div>
        {signal.signal_type} â€” {pct}% confidence
      </div>
      <div>
        {signal.symbol} Â· {fmt(signal.created_at)}
      </div>
      {notes && (
        <div style={{ color: "#6b7280", fontStyle: "italic" }}>{notes}</div>
      )}
    </div>
  );
}
// ===== End LastOutput =====

export default function Trading() {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [lastFetch, setLastFetch] = useState(null);
  const [agentSignals, setAgentSignals] = useState({});
  // Tick drives countdown recalc â€” increments every 1s for real-time display
  const [tick, setTick] = useState(0);

  const fetchData = useCallback(() => {
    fetch("http://localhost:3001/api/trading")
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json();
      })
      .then((d) => {
        setData(d);
        setLastFetch(new Date());
        setLoading(false);
        setError(null);
      })
      .catch((err) => {
        setError(`Failed to load trading data: ${err.message}`);
        setLoading(false);
      });

    fetch("http://localhost:3001/api/trading/data")
      .then((r) => r.json())
      .then((d) => {
        if (d.agentSignals) setAgentSignals(d.agentSignals);
      })
      .catch((e) => console.error("[agentSignals]", e));
  }, []);

  // Single page-level 1s interval: bumps tick every second for real-time countdowns;
  // data fetch only fires at the :00 mark of each 10-min window
  useEffect(() => {
    fetchData();
    const id = setInterval(() => {
      const now = new Date();
      const posInWindow = (now.getMinutes() * 60 + now.getSeconds()) % 600;
      if (posInWindow === 0) {
        fetchData();
      }
      setTick((t) => t + 1);
    }, 1000);
    return () => clearInterval(id);
  }, [fetchData]);

  // Countdown values calculated at page level, passed down as props
  // Data fetch fires at :00 (sec 0), agents at :01 (sec 60), orchestrator at :04 (sec 240)
  // eslint-disable-next-line react-hooks/exhaustive-deps
  const dataCountdownSec = tick >= 0 ? getSecsUntilFire(0) : 0;
  const agentCountdownSec = getSecsUntilFire(60);
  const orchestratorCountdownSec = getSecsUntilFire(240);
  const dataCountdownMs = dataCountdownSec * 1000;

  const sortedLatest = data?.latest
    ? [...data.latest].sort((a, b) => {
        const ai = COIN_ORDER.indexOf(a.coin);
        const bi = COIN_ORDER.indexOf(b.coin);
        if (ai === -1 && bi === -1) return a.coin.localeCompare(b.coin);
        if (ai === -1) return 1;
        if (bi === -1) return -1;
        return ai - bi;
      })
    : [];

  return (
    <div className="container trading-wrapper">
      <div className="trading-header">
        <div className="trading-title-row">
          <h1 className="trading-title">Trading Dashboard</h1>
          <Countdown remainingMs={dataCountdownMs} />
          {lastFetch && (
            <div className="trading-subtitle">
              Last refreshed at {lastFetch.toLocaleTimeString()} &middot;
              auto-refresh every 10 min
            </div>
          )}
        </div>
      </div>

      <TradingAgentsSection
        agentCountdownSec={agentCountdownSec}
        orchestratorCountdownSec={orchestratorCountdownSec}
        agentSignals={agentSignals}
      />

      {loading && <p className="trading-loading">Loading price data...</p>}
      {error && <p className="trading-error">{error}</p>}

      {!loading && !error && data && (
        <>
          <section className="trading-section">
            {sortedLatest.length === 0 ? (
              <p className="trading-empty">
                No price data found in trading_prices table.
              </p>
            ) : (
              <div className="coin-grid">
                {sortedLatest.map((row) => (
                  <CoinCard key={row.coin} row={row} />
                ))}
              </div>
            )}
          </section>

          <section className="trading-section">
            <HistoryTabs />
          </section>
        </>
      )}
    </div>
  );
}

