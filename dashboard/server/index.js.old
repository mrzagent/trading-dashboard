// Data is collected by candle_collector_hl.py from HyperLiquid
// Dashboard reads from trading_prices, trading_prices_1h, trading_prices_4h
// To change collection interval, update candle_collector_hl.py and scheduled tasks
const DATA_SOURCE = { name: 'HyperLiquid', url: 'https://hyperliquid.xyz' };
const COINS = ['BTC', 'ETH', 'SOL'];
const COLLECTION_INTERVAL_MINUTES = 5; // Matches candle_collector_hl.py 5min timeframe

// â”€â”€â”€ Technical indicator helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcRSI(prices, period = 14) {
  if (prices.length < period + 1) return null;
  let gains = 0, losses = 0;
  for (let i = prices.length - period; i < prices.length; i++) {
    const diff = prices[i] - prices[i - 1];
    if (diff >= 0) gains += diff; else losses -= diff;
  }
  const avgGain = gains / period;
  const avgLoss = losses / period;
  if (avgLoss === 0) return 100;
  const rs = avgGain / avgLoss;
  return parseFloat((100 - 100 / (1 + rs)).toFixed(2));
}

// Aggregate 5min closes into timeframe candles and calculate RSI
// timeframes: '1h' (12 candles = 60min/5min), '4h' (48 candles = 240min/5min)
async function calcTimeframeRSI(coin, timeframe) {
  // Data is stored every 5 minutes, so calculate records needed per timeframe candle
  const candlesNeeded = timeframe === '1h' ? 12 : timeframe === '4h' ? 48 : null;
  if (!candlesNeeded) return null;
  
  // For 1h: need 12*15=180 records minimum for full 14-period RSI
  // For 4h: need 48*15=720 records minimum
  // If we don't have enough, we calculate with proportional periods
  const idealTotal = candlesNeeded * 15;
  
  try {
    // LIMIT must be a literal, not a parameter
    const result = await tradingPool.query(
      `SELECT price FROM trading_prices 
       WHERE coin = $1 
       ORDER BY captured_at DESC 
       LIMIT ${idealTotal}`,
      [coin]
    );
    
    if (result.rows.length < candlesNeeded + 1) {
      // Not enough data even for 2 candles
      console.log(`[RSI] Not enough data for ${coin} ${timeframe}: ${result.rows.length} rows`);
      return null;
    }
    
    // Aggregate into timeframe candles (take close of every Nth candle)
    const closes = [];
    for (let i = result.rows.length - 1; i >= 0; i -= candlesNeeded) {
      closes.push(parseFloat(result.rows[i].price));
    }
    closes.reverse();
    
    // Adjust RSI period based on available data
    // Minimum 7 periods, maximum 14
    const availablePeriods = closes.length - 1;
    const rsiPeriod = Math.min(14, Math.max(7, Math.floor(availablePeriods * 0.9)));
    
    if (closes.length < rsiPeriod + 1) {
      console.log(`[RSI] Not enough candles for ${coin} ${timeframe}: ${closes.length} candles, need ${rsiPeriod + 1}`);
      return null;
    }
    
    const rsi = calcRSI(closes, rsiPeriod);
    console.log(`[RSI] ${coin} ${timeframe}: ${rsi} (period=${rsiPeriod}, candles=${closes.length})`);
    return rsi;
  } catch (err) {
    console.error(`Error calculating ${timeframe} RSI for ${coin}:`, err);
    return null;
  }
}

function calcMomentum(prices, period = 10) {
  if (prices.length < period + 1) return null;
  const current = prices[prices.length - 1];
  const prev = prices[prices.length - 1 - period];
  return parseFloat(((current - prev) / prev * 100).toFixed(4));
}

function calcFVG(prices, period = 10) {
  // prices = array of {price, captured_at}
  const recent = prices.slice(-Math.min(period * 3, prices.length));
  const fvgs = [];
  for (let i = 2; i < recent.length; i++) {
    const prev  = parseFloat(recent[i - 2].price);
    const curr  = parseFloat(recent[i].price);
    const mid   = parseFloat(recent[i - 1].price);
    const gap   = Math.abs(curr - prev);
    if (gap < prev * 0.0002) continue; // skip tiny gaps
    const type = curr > prev ? 'bullish' : 'bearish';
    const top    = Math.max(prev, curr);
    const bottom = Math.min(prev, curr);
    fvgs.push({
      top: parseFloat(top.toFixed(2)),
      bottom: parseFloat(bottom.toFixed(2)),
      midpoint: parseFloat(((top + bottom) / 2).toFixed(3)),
      type,
      formed_at: recent[i - 1].captured_at
        ? new Date(recent[i - 1].captured_at).toISOString().slice(0, 16).replace('T', ' ') + ' UTC'
        : null
    });
  }
  // Return last `period` FVGs, most recent first
  const result = fvgs.reverse().slice(0, period);
  return result.length ? result : null;
}

