// ===== Agent Signals Endpoint =====
app.get('/api/trading/data', async (req, res) => {
  try {
    const result = await pool.query(`
      SELECT DISTINCT ON (source, symbol, timeframe)
        source, symbol, COALESCE(timeframe, '5min') AS timeframe,
        signal_type, confidence, notes, created_at
      FROM reuben_signals
      ORDER BY source, symbol, timeframe, created_at DESC
    `);
    const agentSignals = {};
    for (const row of result.rows) {
      if (!agentSignals[row.source]) agentSignals[row.source] = {};
      const tf = row.timeframe || '5min';
      if (!agentSignals[row.source][tf]) agentSignals[row.source][tf] = {};
      agentSignals[row.source][tf][row.symbol] = {
        signal_type: row.signal_type,
        confidence: row.confidence,
        notes: row.notes,
        created_at: row.created_at,
      };
    }
    res.json({ agentSignals });
  } catch (err) {
    console.error('[Trading Data Error]', err.message);
    res.status(500).json({ error: err.message });
  }
});
