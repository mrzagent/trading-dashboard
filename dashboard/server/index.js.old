app.get('/api/agents', async (req, res) => {
  try {
    // Query the database for agent status (including model column)
    const result = await pool.query(
      'SELECT agent_name, emoji, role, model, current_task, task_milestone, last_completed_task, last_active FROM agent_status ORDER BY agent_name ASC'
    );
    
    // Create a map of existing DB entries
    const dbAgents = new Map(result.rows.map(r => [r.agent_name, r]));
    
    // Build complete agent list including all known agents
    const ALL_AGENTS = ['Danny','Livingston','Reuben','Rusty','Saul','Turk','Frank','Linus','Virgil','Basher','Yen'];
    
    const rows = ALL_AGENTS.map(name => {
      const dbRow = dbAgents.get(name);
      // Database is source of truth for model, role; IDENTITY.md as fallback for role
      const identityRole = getAgentRole(name);
      const dbModel = dbRow?.model;
      const identityModel = getAgentPrimaryModel(name);
      
      // Clear tasks if last_active is more than 24 hours ago
      const lastActive = dbRow?.last_active ? new Date(dbRow.last_active) : null;
      const twentyFourHoursAgo = new Date(Date.now() - 24 * 60 * 60 * 1000);
      const isStale = lastActive && lastActive < twentyFourHoursAgo;
      
      return {
        agent_name: name,
        emoji: getAgentEmoji(name) || dbRow?.emoji,
        role: dbRow?.role || (identityRole !== 'Agent' ? identityRole : 'Agent'),
        current_task: isStale ? null : (dbRow?.current_task || null),
        task_milestone: isStale ? null : (dbRow?.task_milestone || null),
        last_completed_task: isStale ? null : (dbRow?.last_completed_task || null),
        last_active: dbRow?.last_active || null,
        model: dbModel || identityModel || 'unknown'
      };
    });
    
    res.json(rows);
  } catch (err) {
    console.error('DB error:', err);
    res.status(500).json({ error: 'Database error', details: err.message });
  }
});

// GET /api/agents/health - Returns agents that haven't reported in >30 minutes
app.get('/api/agents/health', async (req, res) => {
  try {
    const staleMinutes = parseInt(req.query.staleMinutes) || 30;
    
    const result = await pool.query(
      `SELECT agent_name, last_active, current_task 
       FROM agent_status 
       WHERE last_active < NOW() - INTERVAL '${staleMinutes} minutes'
          OR last_active IS NULL
       ORDER BY last_active ASC NULLS FIRST`
    );
    
    res.json({
      staleThresholdMinutes: staleMinutes,
      staleAgents: result.rows,
      count: result.rows.length,
      checkedAt: new Date().toISOString()
    });
  } catch (err) {
    console.error('Health check error:', err);
    res.status(500).json({ error: 'Database error', details: err.message });
  }
});

// POST /api/agents/refresh - Re-read all IDENTITY.md files and update agent metadata
app.post('/api/agents/refresh', async (req, res) => {
  try {
    const metadata = refreshAgentMetadata();
    
    // Also sync to database (including model)
    for (const [name, data] of Object.entries(metadata)) {
      await pool.query(
        `INSERT INTO agent_status (agent_name, emoji, role, model, last_active)
         VALUES ($1, $2, $3, $4, NOW())
         ON CONFLICT (agent_name) 
         DO UPDATE SET emoji = EXCLUDED.emoji, role = EXCLUDED.role, model = EXCLUDED.model`,
        [name, getAgentEmoji(name), data.role, data.model || 'unknown']
      );
    }
    
    res.json({ 
      success: true, 
      message: `Refreshed metadata for ${Object.keys(metadata).length} agents`,
      agents: Object.keys(metadata)
    });
  } catch (err) {
    console.error('Refresh error:', err);
    res.status(500).json({ error: 'Failed to refresh agent metadata', details: err.message });
  }
});

async function readUsageFromDB(period) {
  let timeFilter = '';
  if (period === '24h') timeFilter = "WHERE occurred_at > NOW() - INTERVAL '24 hours'";
  else if (period === '7d') timeFilter = "WHERE occurred_at > NOW() - INTERVAL '7 days'";

  try {
    const result = await pool.query(
      `SELECT agent, model,
              SUM(tokens_in)::int as tokens_in,
              SUM(tokens_out)::int as tokens_out,
              COUNT(*)::int as calls,
              ROUND(SUM(cost_usd)::numeric, 6)::float as cost_usd
       FROM usage_events
       ${timeFilter}
       GROUP BY agent, model
       ORDER BY SUM(tokens_in) DESC`
    );
    return result.rows;
  } catch (e) {
    console.error('usage_events query error:', e.message);
    return [];
  }
}

app.get('/api/usage', async (req, res) => {
  try {
    const period = req.query.period || '24h';
    let timeFilter = '';
    if (period === '24h') timeFilter = "WHERE occurred_at > NOW() - INTERVAL '24 hours'";
    else if (period === '7d') timeFilter = "WHERE occurred_at > NOW() - INTERVAL '7 days'";

    // All usage from usage_events â€” single source of truth
    // model_usage time filter uses logged_at column
    let muTimeFilter = '';
    if (period === '24h') muTimeFilter = "WHERE logged_at > NOW() - INTERVAL '24 hours' AND model NOT LIKE 'anthropic/%'";
    else if (period === '7d') muTimeFilter = "WHERE logged_at > NOW() - INTERVAL '7 days' AND model NOT LIKE 'anthropic/%'";
    else muTimeFilter = "WHERE model NOT LIKE 'anthropic/%'";

    const [byAgentModelRes, byAgentRes, byModelRes, totalsRes, muRes] = await Promise.all([
      pool.query(
        `SELECT agent, model,
                COUNT(*)::int as calls,
                SUM(tokens_in)::int as tokens_in,
                SUM(tokens_out)::int as tokens_out,
                ROUND(SUM(cost_usd)::numeric, 6)::float as cost
         FROM usage_events ${timeFilter}
         GROUP BY agent, model
         ORDER BY SUM(tokens_in) DESC`
      ),
      pool.query(
        `SELECT agent,
                COUNT(*)::int as calls,
                SUM(tokens_in)::int as tokens_in,
                SUM(tokens_out)::int as tokens_out,
                ROUND(SUM(cost_usd)::numeric, 6)::float as cost
         FROM usage_events ${timeFilter}
         GROUP BY agent
         ORDER BY SUM(tokens_in) DESC`
      ),
      pool.query(
        `SELECT model,
                COUNT(*)::int as calls,
                SUM(tokens_in)::int as tokens_in,
                SUM(tokens_out)::int as tokens_out,
                ROUND(SUM(cost_usd)::numeric, 6)::float as cost
         FROM usage_events ${timeFilter}
         GROUP BY model
         ORDER BY SUM(tokens_in) DESC`
      ),
      pool.query(
        `SELECT COALESCE(SUM(tokens_in),0)::int   as total_tokens_in,
                COALESCE(SUM(tokens_out),0)::int  as total_tokens_out,
                ROUND(COALESCE(SUM(cost_usd),0)::numeric, 4)::float as total_cost
         FROM usage_events ${timeFilter}`
      ),
      // Supplementary: non-Anthropic sub-agent usage from model_usage (log_usage.py calls)
      pool.query(
        `SELECT agent, model,
                COUNT(*)::int as calls,
                SUM(tokens_in)::int as tokens_in,
                SUM(tokens_out)::int as tokens_out
         FROM model_usage ${muTimeFilter}
         GROUP BY agent, model`
      ),
    ]);

    // Start with usage_events data
    // Normalize model name: strip provider prefix (e.g. "anthropic/", "xai/", "google/", "ollama/")
    const normModel = m => (m || '').replace(/^[a-z]+\//, '');

    const byAgentMap  = {};
    for (const r of byAgentModelRes.rows) {
      const model = normModel(r.model);
      const key = `${r.agent}__${model}`;
      if (!byAgentMap[key]) byAgentMap[key] = { agent: r.agent, model, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0 };
      byAgentMap[key].calls      += r.calls;
      byAgentMap[key].tokens_in  += r.tokens_in  || 0;
      byAgentMap[key].tokens_out += r.tokens_out || 0;
      byAgentMap[key].cost       += r.cost       || 0;
    }
    const byModelMap = {};
    for (const r of byModelRes.rows) {
      const model = normModel(r.model);
      if (!byModelMap[model]) byModelMap[model] = { model, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0 };
      byModelMap[model].calls      += r.calls;
      byModelMap[model].tokens_in  += r.tokens_in  || 0;
      byModelMap[model].tokens_out += r.tokens_out || 0;
      byModelMap[model].cost       += r.cost       || 0;
    }
    const totals = totalsRes.rows[0];
    let extraCost = 0;

    // Merge non-Anthropic sub-agent data from model_usage
    for (const r of muRes.rows) {
      const tin   = r.tokens_in  || 0;
      const tout  = r.tokens_out || 0;
      const cost  = calcCost(r.model, tin, tout);
      const model = normModel(r.model);
      extraCost  += cost;

      // byAgent (agent+model breakdown)
      const key = `${r.agent}__${model}`;
      if (!byAgentMap[key]) byAgentMap[key] = { agent: r.agent, model, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0 };
      byAgentMap[key].calls      += r.calls;
      byAgentMap[key].tokens_in  += tin;
      byAgentMap[key].tokens_out += tout;
      byAgentMap[key].cost       += cost;

      // byModel
      if (!byModelMap[model]) byModelMap[model] = { model, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0 };
      byModelMap[model].calls      += r.calls;
      byModelMap[model].tokens_in  += tin;
      byModelMap[model].tokens_out += tout;
      byModelMap[model].cost       += cost;
    }

    const byAgent = Object.values(byAgentMap).sort((a, b) => b.tokens_in - a.tokens_in);
    const byModel = Object.values(byModelMap).sort((a, b) => b.tokens_in - a.tokens_in);

    // Build byAgentOnly with all known agents pre-seeded
    const ALL_AGENTS = ['Danny','Livingston','Rusty','Reuben','Saul','Turk','Frank','Linus','Virgil','Basher','Yen'];
    const byAgentOnlyMap = {};
    for (const name of ALL_AGENTS) {
      byAgentOnlyMap[name] = { agent: name, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0, primaryModel: getAgentPrimaryModel(name) };
    }
    for (const r of byAgentRes.rows) {
      if (!byAgentOnlyMap[r.agent]) byAgentOnlyMap[r.agent] = { agent: r.agent, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0 };
      byAgentOnlyMap[r.agent].calls      += r.calls;
      byAgentOnlyMap[r.agent].tokens_in  += r.tokens_in  || 0;
      byAgentOnlyMap[r.agent].tokens_out += r.tokens_out || 0;
      byAgentOnlyMap[r.agent].cost       += r.cost       || 0;
    }
    for (const r of muRes.rows) {
      const tin  = r.tokens_in  || 0;
      const tout = r.tokens_out || 0;
      const cost = calcCost(r.model, tin, tout);
      if (!byAgentOnlyMap[r.agent]) byAgentOnlyMap[r.agent] = { agent: r.agent, calls: 0, tokens_in: 0, tokens_out: 0, cost: 0 };
      byAgentOnlyMap[r.agent].calls      += r.calls;
      byAgentOnlyMap[r.agent].tokens_in  += tin;
      byAgentOnlyMap[r.agent].tokens_out += tout;
      byAgentOnlyMap[r.agent].cost       += cost;
    }
    const byAgentOnly = Object.values(byAgentOnlyMap).sort((a, b) => b.calls - a.calls);

    res.json({
      byAgent,
      byAgentOnly,
      byModel,
      total_tokens_today: (totals.total_tokens_in || 0) + (totals.total_tokens_out || 0),
      total_cost_today:   (totals.total_cost || 0) + extraCost,
    });
  } catch (err) {
    console.error('Usage error:', err);
    res.status(500).json({ error: 'Failed to read usage data', details: err.message });
  }
});

