// GET /api/strategies - return strategy metadata from strategy_registry.py
app.get('/api/strategies', (req, res) => {
  try {
    const { exec } = require('child_process');
    const scriptPath = path.join(PROJECT_ROOT, 'strategy_registry.py');
    
    exec(
      `"${PYTHON_PATH}" "${scriptPath}"`,
      { timeout: 15000, cwd: PROJECT_ROOT, env: { ...process.env, PYTHONPATH: PROJECT_ROOT } },
      (error, stdout, stderr) => {
        if (error) {
          console.error('Strategies fetch error:', error.message);
          return res.status(500).json({ error: 'Failed to load strategies', detail: error.message });
        }
        try {
          const strategies = JSON.parse(stdout.trim());
          res.json(strategies);
        } catch (parseErr) {
          console.error('JSON parse error:', parseErr.message, 'stdout:', stdout.substring(0, 200));
          res.status(500).json({ error: 'Invalid JSON from strategy registry', detail: parseErr.message });
        }
      }
    );
  } catch (err) {
    console.error('Strategies fetch error:', err.message);
    res.status(500).json({ error: 'Failed to load strategies', detail: err.message });
  }
});

// POST /api/trading/close-position - market close a position
app.post('/api/trading/close-position', async (req, res) => {
  const { coin } = req.body;
  
  if (!coin) {
    return res.status(400).json({ error: 'Missing required field: coin' });
  }
  
  try {
    console.log(`[Close Position] Closing ${coin}`);
    
    // Call Python script to close position on Hyperliquid
    const scriptPath = path.join(PROJECT_ROOT, 'close_position.py');
    
    const pythonProcess = spawn(PYTHON_PATH, [scriptPath, coin], {
      cwd: PROJECT_ROOT,
      env: {
        ...process.env,
        PYTHONPATH: PROJECT_ROOT,
        PYTHONPATH: PROJECT_ROOT
      }
    });
    
    let output = '';
    let errorOutput = '';
    let responded = false;
    
    // Set timeout
    const timeout = setTimeout(() => {
      if (!responded) {
        responded = true;
        pythonProcess.kill('SIGTERM');
        console.error('[Close Position] Timeout after 30s');
        res.status(504).json({ error: 'Request timeout' });
      }
    }, 30000);
    
    pythonProcess.stdout.on('data', (data) => {
      output += data.toString();
    });
    
    pythonProcess.stderr.on('data', (data) => {
      errorOutput += data.toString();
      console.error('[Close Position] Python stderr:', data.toString());
    });
    
    pythonProcess.on('close', (code) => {
      if (responded) return;
      responded = true;
      clearTimeout(timeout);
      
      if (code !== 0) {
        console.error('[Close Position] Python script error, code:', code);
        return res.status(500).json({ error: 'Script failed', details: errorOutput });
      }
      
      try {
        const result = JSON.parse(output.trim());
        console.log('[Close Position] Result:', result);
        res.json(result);
      } catch (parseErr) {
        console.error('[Close Position] JSON parse error:', parseErr.message);
        res.status(500).json({ error: 'Invalid response from script', output: output.substring(0, 200) });
      }
    });
    
    pythonProcess.on('error', (err) => {
      if (responded) return;
      responded = true;
      clearTimeout(timeout);
      console.error('[Close Position] Spawn error:', err);
      res.status(500).json({ error: 'Failed to spawn process', details: err.message });
    });
    
  } catch (err) {
    console.error('[Close Position] Unexpected error:', err);
    res.status(500).json({ error: err.message });
  }
});

