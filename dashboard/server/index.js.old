// Prices per 1M tokens (input, output) - update as needed
const MODEL_PRICES = {
  'anthropic/claude-sonnet-4-6':        { in: 3.00,  out: 15.00 },
  'xai/grok-4-1-fast-reasoning':        { in: 0.20,  out: 0.50  },
  'xai/grok-4-1-fast-non-reasoning':    { in: 0.20,  out: 0.50  },
  'xai/grok-code-fast-1':               { in: 0.20,  out: 1.50  },
};

function calcCost(model, tokensIn, tokensOut) {
  const p = MODEL_PRICES[model];
  if (!p) return 0;
  return (tokensIn / 1_000_000) * p.in + (tokensOut / 1_000_000) * p.out;
}

// â”€â”€ Model Utilities â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function normalizeModel(model) {
  if (!model) return 'unknown';
  if (model.includes('/')) return model;
  if (model.includes('claude'))  return `anthropic/${model}`;
  if (model.includes('grok'))    return `xai/${model}`;
  if (model.includes('gpt'))     return `openai/${model}`;
  if (model.includes('gemini'))  return `google/${model}`;
  if (model.includes(':'))       return `ollama/${model}`;
  return model;
}

// Returns all unique models assigned to agents via IDENTITY.md files.
// This pre-seeds the Models table so every known model appears even if it
// has no usage in the current period - no hardcoding required.
function getKnownModels() {
  const models = new Set();
  // Danny (main) always uses the default cloud model
  models.add('anthropic/claude-sonnet-4-6');
  let agentFolders;
  try { agentFolders = fs.readdirSync(AGENTS_DIR); } catch (_) { return [...models]; }
  for (const folder of agentFolders) {
    const identityPath = path.join(AGENTS_DIR, folder, 'IDENTITY.md');
    try {
      const content = fs.readFileSync(identityPath, 'utf8');
      const match = content.match(/\*\*Model:\*\*\s*(.+)/);
      if (match) {
        const m = match[1].trim();
        if (m) models.add(m);
      }
    } catch (_) { /* skip */ }
  }
  return [...models];
}

function readUsageFromSessions(period) {
  const now = Date.now();
  let cutoff = 0;
  if (period === '7d')  cutoff = now - 7  * 24 * 60 * 60 * 1000;
  else if (period === '24h') cutoff = now - 24 * 60 * 60 * 1000;

  const rows = [];
  let agents;
  try { agents = fs.readdirSync(OPENCLAW_AGENTS_DIR); }
  catch (e) { console.error('Cannot read agents dir:', e.message); return rows; }

  for (const agentDir of agents) {
    const sessionsDir = path.join(OPENCLAW_AGENTS_DIR, agentDir, 'sessions');
    if (!fs.existsSync(sessionsDir)) continue;

    let files;
    try { files = fs.readdirSync(sessionsDir).filter(f => f.endsWith('.jsonl') || (cutoff === 0 && (f.includes('.jsonl.deleted.') || f.includes('.jsonl.reset.')))); }
    catch (e) { continue; }

    for (const file of files) {
      const filePath = path.join(sessionsDir, file);
      try {
        // Skip files whose mtime is entirely before the cutoff (fast path)
        if (cutoff > 0) {
          const mtime = fs.statSync(filePath).mtimeMs;
          if (mtime < cutoff) continue;
        }
        const content = fs.readFileSync(filePath, 'utf8');
        for (const line of content.split('\n')) {
          if (!line.trim()) continue;
          try {
            const entry = JSON.parse(line);
            if (entry.message?.role !== 'assistant') continue;
            const ts = new Date(entry.timestamp).getTime();
            if (cutoff > 0 && ts < cutoff) continue;

            const usage      = entry.message?.usage;
            const cacheRead  = usage?.cacheRead  || 0;
            const cacheWrite = usage?.cacheWrite || 0;
            rows.push({
              agent:     AGENT_DISPLAY_NAMES[agentDir] || agentDir,
              model:     normalizeModel(entry.message.model),
              tokensIn:  (usage?.input || 0) + cacheRead + cacheWrite,
              tokensOut: usage?.output || 0,
              cost:      usage?.cost?.total || 0,
            });
          } catch (_) { /* skip malformed lines */ }
        }
      } catch (e) { /* skip unreadable file */ }
    }
  }
  return rows;
}
