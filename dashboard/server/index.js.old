// Health Monitoring Endpoint
app.get('/api/trading/health', async (req, res) => {
  try {
    const { exec } = require('child_process');
    const util = require('util');
    const execPromise = util.promisify(exec);
    
    // Check scheduled task status
    let taskStatus = null;
    try {
      const { stdout } = await execPromise('powershell.exe -Command "Get-ScheduledTask -TaskName TradingOrchestrator | Get-ScheduledTaskInfo | Select-Object LastRunTime, LastTaskResult, NextRunTime | ConvertTo-Json -Compress"');
      taskStatus = JSON.parse(stdout);
    } catch (e) {
      taskStatus = { error: 'Could not fetch task status' };
    }
    
    // Check last signal from database
    let lastSignal = null;
    try {
      const result = await tradingPool.query(
        `SELECT coin, action, strategy, confidence, created_at 
         FROM trading_signals 
         ORDER BY created_at DESC LIMIT 1`
      );
      if (result.rows.length > 0) {
        lastSignal = result.rows[0];
      }
    } catch (e) {
      lastSignal = { error: 'Could not fetch last signal' };
    }
    
    // Check trade_state.json timestamp
    let tradeStateStatus = null;
    try {
      const stats = fs.statSync(path.join(PROJECT_ROOT, 'trade_state.json'));
      const minutesSinceUpdate = (Date.now() - stats.mtime.getTime()) / (1000 * 60);
      tradeStateStatus = {
        lastModified: stats.mtime.toISOString(),
        minutesSinceUpdate: Math.round(minutesSinceUpdate),
        sizeKB: Math.round(stats.size / 1024)
      };
    } catch (e) {
      tradeStateStatus = { error: 'trade_state.json not found' };
    }
    
    // Determine overall health
    const now = new Date();
    let health = 'healthy';
    let issues = [];
    
    // Check if orchestrator ran in last 10 minutes
    if (taskStatus && taskStatus.LastRunTime) {
      const lastRun = new Date(taskStatus.LastRunTime);
      const minutesSinceRun = (now - lastRun) / (1000 * 60);
      if (minutesSinceRun > 10) {
        health = 'warning';
        issues.push(`Orchestrator hasn't run in ${Math.round(minutesSinceRun)} minutes`);
      }
      if (taskStatus.LastTaskResult !== 0) {
        health = 'error';
        issues.push(`Last orchestrator run failed with code ${taskStatus.LastTaskResult}`);
      }
    }
    
    // Check trade state freshness
    if (tradeStateStatus.minutesSinceUpdate > 15) {
      health = tradeStateStatus.minutesSinceUpdate > 30 ? 'error' : 'warning';
      issues.push(`Trade state is ${tradeStateStatus.minutesSinceUpdate} minutes old`);
    }
    
    res.json({
      health,
      issues,
      timestamp: now.toISOString(),
      orchestrator: {
        taskStatus,
        expectedInterval: '5 minutes'
      },
      lastSignal,
      tradeState: tradeStateStatus
    });
  } catch (err) {
    console.error('Health check error:', err);
    res.status(500).json({ error: err.message });
  }
});

