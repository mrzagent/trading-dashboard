// Helper: read risk_config.json defaults synchronously (used for fallback)
function getRiskConfigDefaults() {
  try {
    const raw = JSON.parse(fs.readFileSync(path.join('D:', 'dev', 'trading', 'risk_config.json'), 'utf8'));
    const tpLevels = raw.take_profit_levels || [];
    return {
      leverage: raw.leverage || 3,
      stopLoss: (raw.stop_loss_pct || 0.05) * 100,
      takeProfit: tpLevels.length > 0 ? parseFloat((tpLevels[0].level * 100).toFixed(2)) : 3.0,
    };
  } catch (_) {
    return { leverage: 3, stopLoss: 5.0, takeProfit: 3.0 };
  }
}

// Helper: read account settings from .account_settings.json
function getAccountSettings() {
  try {
    const settingsPath = path.join('D:', 'dev', 'trading', '.account_settings.json');
    const raw = JSON.parse(fs.readFileSync(settingsPath, 'utf8'));
    const env = raw.environment ?? 'testnet';
    const envConfig = raw[env] ?? {};
    return {
      tradingEnabled: raw.tradingEnabled ?? false,
      cooldownMinutes: raw.cooldownMinutes ?? 30,
      allowMultiplePositions: raw.allowMultiplePositions ?? false,
      positionSizePct: raw.positionSizePct ?? 2.0,
      environment: env,
      apiUrl: envConfig.apiUrl ?? (env === 'mainnet' ? 'https://api.hyperliquid.xyz' : 'https://api.hyperliquid-testnet.xyz'),
      walletAddress: envConfig.walletAddress ?? '',
      testnet: raw.testnet ?? { apiUrl: 'https://api.hyperliquid-testnet.xyz', walletAddress: '', privateKeyEnv: 'HYPERLIQUID_TESTNET_PRIVATE_KEY' },
      mainnet: raw.mainnet ?? { apiUrl: 'https://api.hyperliquid.xyz', walletAddress: '', privateKeyEnv: 'HYPERLIQUID_MAINNET_PRIVATE_KEY' },
    };
  } catch (_) {
    return { 
      tradingEnabled: false,
      cooldownMinutes: 30, 
      allowMultiplePositions: false, 
      positionSizePct: 2.0,
      environment: 'testnet',
      apiUrl: 'https://api.hyperliquid-testnet.xyz',
      walletAddress: '',
      testnet: { apiUrl: 'https://api.hyperliquid-testnet.xyz', walletAddress: '', privateKeyEnv: 'HYPERLIQUID_TESTNET_PRIVATE_KEY' },
      mainnet: { apiUrl: 'https://api.hyperliquid.xyz', walletAddress: '', privateKeyEnv: 'HYPERLIQUID_MAINNET_PRIVATE_KEY' }
    };
  }
}

// GET /api/trading/account - get account info (balance, addresses, deployed capital)
app.get('/api/trading/account', async (req, res) => {
  try {
    // Get environment-specific wallet addresses from settings
    const settings = getAccountSettings();
    const env = settings.environment || 'testnet';
    const envConfig = settings[env] || {};
    
    const MAIN_WALLET = envConfig.mainWalletAddress || envConfig.walletAddress || '0x97c465489243175580fcDe624c2ef640c1897a00';
    const AGENT_WALLET = envConfig.walletAddress || process.env.HYPERLIQUID_WALLET || '0x89823A4f85cc8ef3A5574E8a56741A7b4562f288';
    
    // Run Python to fetch account info
    const scriptPath = path.join(PROJECT_ROOT, 'get_account_info.py');
    
    const pythonProcess = spawn(PYTHON_PATH, [scriptPath], {
      cwd: PROJECT_ROOT,
      env: { 
        ...process.env, 
        PYTHONIOENCODING: 'utf-8',
        PYTHONPATH: PROJECT_ROOT
      }
    });
    
    let output = '';
    let errorOutput = '';
    let responded = false;
    
    pythonProcess.stdout.on('data', (data) => {
      output += data.toString();
    });
    
    pythonProcess.stderr.on('data', (data) => {
      errorOutput += data.toString();
    });
    
    const timeout = setTimeout(() => {
      if (responded) return;
      responded = true;
      pythonProcess.kill();
      // Return fallback data from risk_config.json
      const rfd = getRiskConfigDefaults();
      res.json({
        mainWallet: MAIN_WALLET,
        agentWallet: AGENT_WALLET,
        balance: 0,
        deployedCapital: 0,
        available: 0,
        positionCount: 0,
        unrealizedPnl: 0,
        totalMargin: 0,
        pnl24h: null,
        pnl7d: null,
        pnl30d: null,
        ...rfd,
      });
    }, 10000);
    
    pythonProcess.on('close', (code) => {
      if (responded) return;
      responded = true;
      clearTimeout(timeout);
      
      if (code !== 0) {
        console.error('[Account] Python error:', code, errorOutput);
        const rfd2 = getRiskConfigDefaults();
        const settings2 = getAccountSettings();
        return res.json({
          mainWallet: MAIN_WALLET,
          agentWallet: AGENT_WALLET,
          balance: 0,
          deployedCapital: 0,
          available: 0,
          positionCount: 0,
          unrealizedPnl: 0,
          totalMargin: 0,
          pnl24h: null,
          pnl7d: null,
          pnl30d: null,
          ...rfd2,
          ...settings2
        });
      }
      
      try {
        const data = JSON.parse(output.trim());
        const settings = getAccountSettings();
        res.json({
          mainWallet: MAIN_WALLET,
          agentWallet: AGENT_WALLET,
          ...data,
          ...settings
        });
      } catch (parseErr) {
        console.error('[Account] JSON parse error:', parseErr.message);
        const rfd3 = getRiskConfigDefaults();
        const settings3 = getAccountSettings();
        res.json({
          mainWallet: MAIN_WALLET,
          agentWallet: AGENT_WALLET,
          balance: 0,
          deployedCapital: 0,
          available: 0,
          positionCount: 0,
          unrealizedPnl: 0,
          totalMargin: 0,
          pnl24h: null,
          pnl7d: null,
          pnl30d: null,
          ...rfd3,
          ...settings3
        });
      }
    });
    
    pythonProcess.on('error', (err) => {
      if (responded) return;
      responded = true;
      clearTimeout(timeout);
      console.error('[Account] Spawn error:', err);
      const rfd4 = getRiskConfigDefaults();
      const settings4 = getAccountSettings();
      res.json({
        mainWallet: MAIN_WALLET,
        agentWallet: AGENT_WALLET,
        balance: 0,
        deployedCapital: 0,
        available: 0,
        positionCount: 0,
        unrealizedPnl: 0,
        totalMargin: 0,
        pnl24h: null,
        pnl7d: null,
        pnl30d: null,
        ...rfd4,
        ...settings4
      });
    });
  } catch (err) {
    console.error('Account fetch error:', err);
    res.status(500).json({ error: err.message });
  }
});

// POST /api/trading/account - update account settings (leverage, sl, tp, cooldown, position rules, environment, trading enabled)
app.post('/api/trading/account', async (req, res) => {
  try {
    const { tradingEnabled, leverage, stopLoss, takeProfit, cooldownMinutes, allowMultiplePositions, positionSizePct, environment, testnet, mainnet } = req.body;
    
    // Save to settings file
    const settingsPath = path.join('D:', 'dev', 'trading', '.account_settings.json');
    let settings = {};
    
    try {
      const data = await fsp.readFile(settingsPath, 'utf8');
      settings = JSON.parse(data);
    } catch (e) {
      // File doesn't exist
    }
    
    if (tradingEnabled !== undefined) settings.tradingEnabled = tradingEnabled;
    if (leverage !== undefined) settings.leverage = leverage;
    if (stopLoss !== undefined) settings.stopLoss = stopLoss;
    if (takeProfit !== undefined) settings.takeProfit = takeProfit;
    if (cooldownMinutes !== undefined) settings.cooldownMinutes = cooldownMinutes;
    if (allowMultiplePositions !== undefined) settings.allowMultiplePositions = allowMultiplePositions;
    if (positionSizePct !== undefined) settings.positionSizePct = positionSizePct;
    if (environment !== undefined && environment !== null) settings.environment = environment;
    if (testnet !== undefined) settings.testnet = { ...settings.testnet, ...testnet };
    if (mainnet !== undefined) settings.mainnet = { ...settings.mainnet, ...mainnet };
    settings.updatedAt = new Date().toISOString();
    
    await fsp.writeFile(settingsPath, JSON.stringify(settings, null, 2));

    // Also update risk_config.json â€” this is the source of truth for the trading bot
    const riskConfigPath = path.join('D:', 'dev', 'trading', 'risk_config.json');
    try {
      let riskConfig = {};
      try {
        const riskData = await fsp.readFile(riskConfigPath, 'utf8');
        riskConfig = JSON.parse(riskData);
      } catch (e) {
        // File doesn't exist yet
      }

      if (leverage !== undefined) {
        riskConfig.leverage = parseFloat(leverage);
      }
      if (stopLoss !== undefined) {
        riskConfig.stop_loss_pct = parseFloat(stopLoss) / 100;
      }
      if (takeProfit !== undefined) {
        const tpDecimal = parseFloat(takeProfit) / 100;
        // Update the first TP level; keep other levels scaled proportionally
        const existingLevels = riskConfig.take_profit_levels || [];
        if (existingLevels.length > 0) {
          const oldFirstLevel = existingLevels[0].level;
          riskConfig.take_profit_levels = existingLevels.map((lvl, i) => {
            if (i === 0) return { ...lvl, level: tpDecimal };
            // Scale subsequent levels proportionally
            const ratio = oldFirstLevel > 0 ? lvl.level / oldFirstLevel : (i + 1);
            return { ...lvl, level: parseFloat((tpDecimal * ratio).toFixed(4)) };
          });
        } else {
          riskConfig.take_profit_levels = [
            { level: tpDecimal, close_pct: 0.25, label: 'TP1' },
            { level: tpDecimal * 1.5, close_pct: 0.25, label: 'TP2' },
            { level: tpDecimal * 2, close_pct: 0.25, label: 'TP3' },
            { level: tpDecimal * 2.5, close_pct: 0.25, label: 'TP4' },
          ];
        }
      }

      await fsp.writeFile(riskConfigPath, JSON.stringify(riskConfig, null, 2));
      console.log('[Account] risk_config.json updated:', { leverage, stopLoss, takeProfit });
    } catch (riskErr) {
      console.error('[Account] Failed to update risk_config.json:', riskErr.message);
      // Non-fatal â€” still return success for the main settings update
    }
    
    res.json({ success: true, settings });
  } catch (err) {
    console.error('Account update error:', err);
    res.status(500).json({ error: err.message });
  }
});

