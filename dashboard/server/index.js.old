// ================= ADDITIONAL TRADING ROUTES =================

// GET /api/trading/signals - recent signals from database + position opens
// Query params:
//   limit: number of signals per page (default 20, max 100)
//   page: page number (default 1)
//   action: filter by action - 'BUY', 'SELL', 'HOLD', or 'ALL' (default 'ALL')
//   minConfidence: minimum confidence threshold (default 0)
app.get('/api/trading/signals', async (req, res) => {
  try {
    const limit = Math.min(parseInt(req.query.limit) || 20, 100); // Max 100 per page
    const page = Math.max(parseInt(req.query.page) || 1, 1);
    const offset = (page - 1) * limit;
    const actionFilter = req.query.action || 'ALL';
    const minConfidence = parseFloat(req.query.minConfidence) || 0;
    
    let signals = [];
    let totalCount = 0;
    
    // Build WHERE clause
    let whereClause = '';
    const params = [];
    let paramIndex = 1;
    
    if (actionFilter !== 'ALL' && ['BUY', 'SELL', 'HOLD'].includes(actionFilter)) {
      whereClause = `WHERE action = $${paramIndex}`;
      params.push(actionFilter);
      paramIndex++;
    }
    
    if (minConfidence > 0) {
      whereClause += whereClause ? ` AND confidence >= $${paramIndex}` : `WHERE confidence >= $${paramIndex}`;
      params.push(minConfidence);
      paramIndex++;
    }
    
    // First, get total count for pagination
    try {
      const countQuery = `SELECT COUNT(*) as total FROM trading_signals ${whereClause}`;
      const countResult = await tradingPool.query(countQuery, params);
      totalCount = parseInt(countResult.rows[0].total);
    } catch (countErr) {
      console.log('Count query error:', countErr.message);
    }
    
    // Get signals from database with pagination
    try {
      const queryParams = [...params, limit, offset];
      const { rows } = await tradingPool.query(
        `SELECT 
          id,
          coin,
          action,
          strategy,
          confidence,
          reason as notes,
          meta,
          created_at,
          EXTRACT(EPOCH FROM (NOW() - created_at))/60 as minutes_ago
        FROM trading_signals 
        ${whereClause}
        ORDER BY created_at DESC 
        LIMIT $${paramIndex} OFFSET $${paramIndex + 1}`,
        queryParams
      );
      
      signals = rows.map(row => {
        // Parse meta to extract style
        let style = null;
        try {
          const meta = typeof row.meta === 'string' ? JSON.parse(row.meta) : row.meta;
          style = meta?.strategy_style || null;
        } catch (_) { /* ignore parse errors */ }
        
        return {
          id: row.id,
          coin: row.coin?.replace('USD', '') || row.coin,
          action: ['BUY', 'SELL'].includes(row.action) ? row.action : 'HOLD',
          strategy: row.strategy || 'Unknown',
          confidence: parseFloat(row.confidence) || 0,
          notes: row.notes,
          style: style,
          createdAt: row.created_at,
          timeAgo: formatTimeAgo(row.minutes_ago)
        };
      });
    } catch (dbErr) {
      console.log('Database signals fetch error:', dbErr.message);
      console.log('Error details:', dbErr);
    }
    
    // Also get position opens from position_state.json (for trades placed directly)
    try {
      const positionPath = path.join('D:', 'dev', 'trading', '.position_state.json');
      const data = await fsp.readFile(positionPath, 'utf8');
      const state = JSON.parse(data);
      
      if (state.positions) {
        for (const [symbol, pos] of Object.entries(state.positions)) {
          const detectedAt = pos.detected_at || pos.openedAt;
          if (detectedAt) {
            const coin = pos.coin || symbol.split('_')[0];
            const side = pos.side || (symbol.includes('_') ? symbol.split('_')[1] : 'LONG');
            const minutesAgo = (Date.now() - new Date(detectedAt).getTime()) / 60000;
            
            signals.push({
              id: `pos-${symbol}`,
              coin: coin,
              action: side.toUpperCase() === 'LONG' ? 'BUY' : 'SELL',
              strategy: 'Manual/Executor',
              confidence: 1.0,
              timeframe: 'N/A',
              notes: `Position opened at $${pos.entry_px || pos.entryPrice || 0}`,
              createdAt: detectedAt,
              timeAgo: formatTimeAgo(minutesAgo)
            });
          }
        }
      }
    } catch (fileErr) {
      // Position file might not exist, that's ok
    }
    
    // Sort by created_at descending
    signals.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    
    // Return with pagination metadata
    const responseData = {
      signals: signals,
      pagination: {
        page: page,
        limit: limit,
        total: totalCount,
        totalPages: Math.ceil(totalCount / limit),
        hasNext: page * limit < totalCount,
        hasPrev: page > 1
      },
      filters: {
        action: actionFilter,
        minConfidence: minConfidence
      }
    };
    return res.json(responseData);
  } catch (err) {
    console.error('Signals fetch error:', err);
    res.status(500).json({ error: err.message });
  }
});

// GET /api/trading/positions - open positions from Hyperliquid
app.get('/api/trading/positions', async (req, res) => {
  const timeoutMs = 30000; // 30 second timeout
  
  try {
    // Call Python script to fetch real positions from Hyperliquid
    const pythonPath = 'C:\\Users\\mrztms\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe';
    const scriptPath = path.join(PROJECT_ROOT, 'get_positions_for_dashboard.py');
    
    console.log('[Positions] Fetching from Hyperliquid...');
    console.log('[Positions] Python path:', PYTHON_PATH);
    console.log('[Positions] Script path:', scriptPath);
    
    const pythonProcess = spawn(PYTHON_PATH, [scriptPath], {
      cwd: PROJECT_ROOT,
      env: {
        ...process.env,
        PYTHONPATH: PROJECT_ROOT
      }
    });
    
    console.log('[Positions] Spawned process PID:', pythonProcess.pid);
    
    let output = '';
    let errorOutput = '';
    let responded = false;
    
    // Set timeout
    const timeout = setTimeout(() => {
      if (!responded) {
        responded = true;
        pythonProcess.kill('SIGTERM');
        console.error('[Positions] Timeout after', timeoutMs, 'ms');
        res.json([]); // Return empty on timeout
      }
    }, timeoutMs);
    
    pythonProcess.stdout.on('data', (data) => {
      output += data.toString();
    });
    
    pythonProcess.stderr.on('data', (data) => {
      errorOutput += data.toString();
      console.error('[Positions] Python stderr:', data.toString());
    });
    
    pythonProcess.on('close', (code) => {
      if (responded) return;
      responded = true;
      clearTimeout(timeout);
      
      if (code !== 0) {
        console.error('[Positions] Python script error, code:', code, 'stderr:', errorOutput);
        return res.json([]);
      }
      
      try {
        const positions = JSON.parse(output.trim());
        console.log('[Positions] Found', positions.length, 'positions');
        const settings = getAccountSettings();
        res.json({
          environment: settings.environment || 'testnet',
          positions: positions
        });
      } catch (parseErr) {
        console.error('[Positions] JSON parse error:', parseErr.message, 'Output:', output.substring(0, 200));
        const settings = getAccountSettings();
        res.json({
          environment: settings.environment || 'testnet',
          positions: []
        });
      }
    });
    
    pythonProcess.on('error', (err) => {
      if (responded) return;
      responded = true;
      clearTimeout(timeout);
      console.error('[Positions] Spawn error:', err);
      const settings = getAccountSettings();
      res.json({
        environment: settings.environment || 'testnet',
        positions: []
      });
    });
    
  } catch (err) {
    console.error('[Positions] Unexpected error:', err);
    const settings = getAccountSettings();
    res.status(500).json({
      environment: settings.environment || 'testnet',
      error: err.message,
      positions: []
    });
  }
});

// POST /api/trading/positions - create a test position
app.post('/api/trading/positions', async (req, res) => {
  try {
    const { coin, side, size, entryPrice, stopLoss, takeProfit } = req.body;
    const positionPath = path.join('D:', 'dev', 'trading', '.position_state.json');
    
    let state = { positions: {} };
    try {
      const data = await fsp.readFile(positionPath, 'utf8');
      state = JSON.parse(data);
      if (!state.positions) state.positions = {};
    } catch (e) {
      // File doesn't exist, start fresh
    }
    
    const symbol = coin + 'USD';
    const markPrice = entryPrice * (1 + (Math.random() * 0.02 - 0.01)); // +/- 1%
    const unrealizedPnl = (markPrice - entryPrice) * size * (side === 'LONG' ? 1 : -1);
    
    state.positions[symbol] = {
      side: side.toLowerCase(),
      size: parseFloat(size),
      entryPrice: parseFloat(entryPrice),
      markPrice: markPrice,
      stopLoss: parseFloat(stopLoss),
      takeProfit: parseFloat(takeProfit),
      unrealizedPnl: unrealizedPnl,
      openedAt: new Date().toISOString()
    };
    
    await fsp.writeFile(positionPath, JSON.stringify(state, null, 2));
    
    res.json({ 
      success: true, 
      position: {
        id: symbol,
        coin: coin,
        side: side,
        size: size,
        entryPrice: entryPrice,
        markPrice: markPrice,
        stopLoss: stopLoss,
        takeProfit: takeProfit,
        unrealizedPnl: unrealizedPnl
      }
    });
  } catch (err) {
    console.error('Position create error:', err);
    res.status(500).json({ error: err.message });
  }
});

