    strategies[id] = active;
    await fsp.writeFile(strategyPath, JSON.stringify(strategies, null, 2));
    
    res.json({ success: true, id, active });
  } catch (err) {
    console.error('Strategy toggle error:', err);
    res.status(500).json({ error: err.message });
  }
});

// GET /api/trading/executions - get trade execution pipeline status
app.get('/api/trading/executions', async (req, res) => {
  try {
    const limit = parseInt(req.query.limit) || 50;
    const coin = req.query.coin || null;
    
    let query = `
      SELECT 
        te.id,
        te.signal_id,
        te.coin,
        te.strategy,
        te.action,
        te.confidence,
        te.signal_generated,
        te.signal_generated_at,
        te.orchestrator_processed,
        te.orchestrator_processed_at,
        te.orchestrator_skip_reason,
        te.hyperliquid_sent,
        te.hyperliquid_sent_at,
        te.hyperliquid_response,
        te.hyperliquid_error,
        te.hyperliquid_order_id,
        te.status,
        te.created_at,
        ts.meta as signal_meta
      FROM trade_executions te
      LEFT JOIN trading_signals ts ON te.signal_id = ts.id
      WHERE 1=1
    `;
    
    const params = [];
    let paramIndex = 1;
    
    if (coin) {
      query += ` AND te.coin = $${paramIndex}`;
      params.push(coin);
      paramIndex++;
    }
    
    query += ` ORDER BY te.created_at DESC LIMIT $${paramIndex}`;
    params.push(limit);
    
    const result = await tradingPool.query(query, params);
    
    // Format executions for frontend
    const executions = result.rows.map(row => {
      // Parse signal meta for additional info
      let style = null;
      try {
        const meta = typeof row.signal_meta === 'string' ? JSON.parse(row.signal_meta) : row.signal_meta;
        style = meta?.strategy_style || null;
      } catch (_) {}
      
      // Calculate pipeline stages
      const stages = {
        signal: {
          status: row.signal_generated ? 'success' : 'pending',
          timestamp: row.signal_generated_at
        },
        orchestrator: {
          status: row.orchestrator_processed 
            ? 'success' 
            : (row.orchestrator_skip_reason ? 'skipped' : 'pending'),
          timestamp: row.orchestrator_processed_at,
          reason: row.orchestrator_skip_reason
        },
        hyperliquid: {
          status: row.hyperliquid_response === 'success' 
            ? 'success' 
            : (row.hyperliquid_response === 'failed' ? 'failed' : (row.hyperliquid_sent ? 'pending' : 'pending')),
          timestamp: row.hyperliquid_sent_at,
          error: row.hyperliquid_error,
          orderId: row.hyperliquid_order_id
        }
      };
      
      // Calculate time ago
      const minutesAgo = row.created_at 
        ? (Date.now() - new Date(row.created_at).getTime()) / 60000 
        : null;
      
      return {
        id: row.id,
        signalId: row.signal_id,
        coin: row.coin,
        strategy: row.strategy,
        action: row.action,
        confidence: parseFloat(row.confidence) || 0,
        style: style,
        stages: stages,
        overallStatus: row.status,
        createdAt: row.created_at,
        timeAgo: formatTimeAgo(minutesAgo)
      };
    });
    
    res.json({
      executions: executions,
      count: executions.length
    });
  } catch (err) {
    console.error('Executions fetch error:', err);
    res.status(500).json({ error: err.message });
  }
});

// Helper: format time ago
function formatTimeAgo(minutes) {
  if (!minutes || minutes < 1) return 'just now';
  if (minutes < 60) return `${Math.floor(minutes)}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  return `${Math.floor(hours / 24)}d ago`;
}

// GET /api/trading/wallet - get connected wallet address
app.get('/api/trading/wallet', async (req, res) => {
  try {
    // Try to read wallet from trading bot config or env
    let address = '';
    
    // Check environment variables first
    if (process.env.HYPERLIQUID_WALLET) {
      address = process.env.HYPERLIQUID_WALLET;
    } else if (process.env.WALLET_ADDRESS) {
      address = process.env.WALLET_ADDRESS;
    } else {
      // Try to read from a wallet config file
      try {
        const walletPath = path.join('D:', 'dev', 'trading', '.wallet.json');
        const data = await fsp.readFile(walletPath, 'utf8');
        const wallet = JSON.parse(data);
        address = wallet.address || '';
      } catch (e) {
        // No wallet file, return empty
      }
    }
    
    res.json({ address, connected: !!address });
  } catch (err) {
    console.error('Wallet fetch error:', err);
    res.status(500).json({ error: err.message });
  }
});

